		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock when" doc:id="35f74a09-e751-4fef-8da0-f44dc3ac6e90" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Request Gemini AI" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[%dw 2.0&#10;output application/json&#10;---&#10;readUrl('classpath://gemini-response.json','application/json')]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="92f0e78e-20bc-4fad-afc8-529b0278de5b" >
				<munit:payload value='"Do you love me?"' />
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to google-aiFlow" doc:id="f5f019cf-dcf3-4151-98f3-5233482e418c" name="post:\googleai:application\json:gen-ai-config"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert doc:name="Assert expression" doc:id="f102eaf1-9d4b-4a66-8c61-dadee9b3b1e4" >
				<munit-tools:that ><![CDATA[#[%dw 2.0
import file1
---
file1::main({payload: payload, attributes: attributes, vars: vars})]]]></munit-tools:that>
			</munit-tools:assert>
		</munit:validation>
	</munit:test>
